# SITE_ADDRESS comes from the root .env. A domain name (promanage.example.com)
# makes Caddy fetch and renew a Let's Encrypt certificate and redirect HTTP to
# HTTPS; ":80" serves plain HTTP (only for a first test by IP address).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets, so it can be cached for good.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes (/projects/3, ...) all load the single page.
		try_files {path} /index.html
		file_server
	}
}
