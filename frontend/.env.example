# MAEC frontend configuration. Copy to `.env` only to override the default.
# Who is signed in comes from MAEC One (its cookie), not from this file.

# Leave unset (or empty): the app calls /api on its own origin. The container's web server,
# and `npm run dev` (vite.config.js), forward it to the backend. A different origin would not
# carry MAEC One's cookie.
# VITE_API_BASE_URL=
