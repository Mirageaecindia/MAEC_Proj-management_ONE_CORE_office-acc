# Database connection (SQLAlchemy URL). Leave unset to use backend/promanage.db.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/promanage

# Security: sessions expire this many hours after login; this many failed
# logins for one username lock it for the lockout period (HTTP 429).
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Microsoft Azure AD App Registration Configuration
# Register an app in Azure AD (portal.azure.com) with the following:
# 1. Redirect URI: http://localhost:8000 (or your production URL)
# 2. API Permissions: Sites.ReadWrite.All (or Sites.Selected for tighter scope)
# 3. Admin consent granted for the tenant
# 4. Client Secret created under Certificates & secrets

# Azure AD App (Client) ID
AZURE_CLIENT_ID=your-client-id-here

# Azure AD App Client Secret
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure AD Tenant ID (Directory ID)
AZURE_TENANT_ID=your-tenant-id-here

# SharePoint Site Configuration
# Site: https://mirageace.sharepoint.com/sites/Automation
# Library: Shared Documents / Project_Mirage_Manage / delivery / Project
# To get the site ID, you can use Graph Explorer: 
# GET https://graph.microsoft.com/v1.0/sites/mirageace.sharepoint.com:/sites/Automation
SHAREPOINT_SITE_ID=your-sharepoint-site-id-here

# SharePoint site root URL (used to build the folder web URL fallback)
# Default: https://mirageace.sharepoint.com/sites/Automation
SHAREPOINT_SITE_URL=https://mirageace.sharepoint.com/sites/Automation

# Optional: SharePoint Drive ID (if not using default "Shared Documents")
# GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id-here

# Target folder path relative to drive root
# This should match: Project_Mirage_Manage/delivery/Project
SHAREPOINT_TARGET_PATH=Project_Mirage_Manage/delivery/Project