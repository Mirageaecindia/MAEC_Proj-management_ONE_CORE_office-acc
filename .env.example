# Settings for docker-compose.yml. On the server: cp .env.example .env, fill it
# in, chmod 600 .env. Never commit .env. Every compose command passes it explicitly:
#   docker compose -f docker-compose.yml --env-file .env ...

# Database password. Letters and digits only (it is part of a URL).
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- MAEC One's gate: the backend refuses to start without these ----------------
# Nobody signs in to Project Management: MAEC One Core does. On every request the
# backend asks Core whether the browser's MAEC One cookie belongs to someone with a
# seat on Project Management (backend/app/api/gate.py).

# Core as THIS SERVER reaches it: inside Docker, on maec_core_net, so the check never
# leaves the machine.
CORE_URL=http://maec-core:8000

# Core as a BROWSER reaches it: where "Sign out" and "Change password" point.
CORE_PUBLIC_URL=https://auth.mirageaec.com

# This app's key in Core.
MAEC_APP_KEY=projects

# This app's entry in Core's GATE_SECRETS (projects=<the same value>). At least 32
# characters; the backend refuses to start with this placeholder. Generate it once, on
# the server, and put it in both places:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse one that has been pasted into a chat, a ticket or a commit.
MAEC_GATE_SECRET=generate-on-the-server

# --- docker-compose.yml, optional ---------------------------------------------
# Leave unset: the compose file's defaults are the VPS's values.
# PM_PORT=8083
# PM_NET_SUBNET=10.231.3.0/24

# Audit log entries older than this many days are deleted.
# AUDIT_RETENTION_DAYS=30

# SharePoint / Microsoft Graph (see backend/.env.example). Empty = not configured.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# SHAREPOINT_SITE_URL=https://mirageace.sharepoint.com/sites/Automation
# SHAREPOINT_TARGET_PATH=Project_Mirage_Manage/delivery/Project
