# Settings for docker-compose.yml. On the server: cp .env.example .env, fill it
# in, chmod 600 .env. Never commit .env.

# Database password. Letters and digits only (it is part of a URL).
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Public address. A domain name whose DNS A record points at the server
# (e.g. promanage.example.com) gets automatic HTTPS from Let's Encrypt.
# ":80" serves plain HTTP: only for a first test by IP address.
SITE_ADDRESS=:80

# Sessions and login lockout (defaults shown).
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# SharePoint / Microsoft Graph (see backend/.env.example). Empty = not configured.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# SHAREPOINT_SITE_URL=https://mirageace.sharepoint.com/sites/Automation
# SHAREPOINT_TARGET_PATH=Project_Mirage_Manage/delivery/Project
